# SecureAct AI Platform Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origin (in addition to defaults: localhost:5173, localhost:3000)
ALLOWED_ORIGIN=http://localhost:5173

# URL Scanner Settings
URL_CONNECT_TIMEOUT=5.0
URL_READ_TIMEOUT=10.0
URL_MAX_RESPONSE_BYTES=5242880
URL_MAX_REDIRECTS=3
URL_BATCH_MAX=10
URL_BATCH_CONCURRENCY=3

# Rate Limiter Settings
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
